{
  "languages": {
    "Python": {
      "language_servers": ["ruff", "pyrefly"],
      "format_on_save": "on",
      "formatter": [
        { "code_action": "source.fixAll.ruff" },
        { "code_action": "source.fixAll.pyrefly" },
        { "language_server": { "name": "ruff" } },
      ],
    },
  },

  "lsp": {
    "pyrefly": {
      "binary": {
        "path": ".venv/Scripts/pyrefly.exe",
        "arguments": ["lsp"],
      },
    },
  },
}
